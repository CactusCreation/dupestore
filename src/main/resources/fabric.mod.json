{
	"schemaVersion": 1,
	"id": "dupestore",
	"version": "${version}",
	"name": "DupeStore",
	"description": "A small mod allowing you to see duplication methods that have historically worked, in attempt to make plugin debugging easier.",
	"authors": [
		"CactusCreative"
	],
	"contact": {
		"homepage": "https://github.com/CactusCreation/dupestore",
		"sources": "https://github.com/CactusCreation/dupestore"
	},
	"license": "CC0-1.0",
	"icon": "assets/dupestore/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.cactuscreative.dupestore.client.DupeStoreClient"
		]
	},
	"mixins": [
		{
			"config": "dupestore.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "1.21.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}